<Window x:Class="SadFontsUtilGUI.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error - SadFontsUtil" Height="400" Width="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtErrorTitle" Text="Error generating preview" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <TextBox x:Name="txtErrorDetails" Grid.Row="1" Margin="0,0,0,10"
                 TextWrapping="WrapWithOverflow" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True" AcceptsReturn="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCopy" Content="Copy to Clipboard" Width="120" Height="30" Margin="0,0,10,0" Click="BtnCopy_Click"/>
            <Button x:Name="btnClose" Content="Close" Width="80" Height="30" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
