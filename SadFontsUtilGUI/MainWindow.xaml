<Window x:Class="SadFontsUtilGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SadFontsUtil - Font Generator" Height="700" Width="900"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Font Selection -->
        <GroupBox Header="Font Source" Margin="0,0,0,10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFontPath" Grid.Column="0" Margin="0,0,5,0" IsReadOnly="True"/>
                <Button x:Name="btnBrowse" Grid.Column="1" Content="Browse..." Width="80" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <!-- Parameters -->
        <GroupBox Header="Settings" Margin="0,0,0,10" Padding="5" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Character Height -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,5">
                    <Label Content="Character Height (px):" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtCharHeight" Text="16" Width="100"/>
                </StackPanel>

                <!-- Character Range - Separate fields -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,5">
                    <Label Content="Character Range:" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox x:Name="txtCharFrom" Text="32" Width="50" Margin="0,0,5,0"/>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtCharTo" Text="126" Width="50"/>
                    </StackPanel>
                </StackPanel>

                <!-- Grid Size - Separate fields -->
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,5">
                    <Label Content="Grid Size:" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox x:Name="txtGridSizeX" Text="16" Width="50" Margin="0,0,5,0"/>
                        <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtGridSizeY" Text="16" Width="50"/>
                    </StackPanel>
                </StackPanel>

                <!-- Grid Cell Size - Separate fields -->
                <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,5">
                    <Label Content="Grid Cell Size:" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox x:Name="txtGridCellX" Text="8" Width="50" Margin="0,0,5,0"/>
                        <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtGridCellY" Text="16" Width="50"/>
                    </StackPanel>
                </StackPanel>

                <!-- Grid Lines -->
                <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,5" Orientation="Horizontal">
                    <CheckBox x:Name="chkGridLines" IsChecked="True" Content="Show grid lines" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Font file label -->
                <StackPanel Grid.Column="0" Grid.Row="5" Margin="0,10,0,0">
                    <Label Content="Selected Font:" Margin="0,0,0,3" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSelectedFont" Text="None" Foreground="Gray" FontStyle="Italic"/>
                </StackPanel>

                <!-- Preview Scale -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,5">
                    <Label Content="Preview Scale (%):" Margin="0,0,0,3"/>
                    <Slider x:Name="sldPreviewScale" Minimum="10" Maximum="200" Value="100" Width="150"
                            Thumb.DragStarted="SldPreviewScale_DragStarted" Thumb.DragCompleted="SldPreviewScale_DragCompleted"/>
                    <TextBlock Text="{Binding Value, ElementName=sldPreviewScale, StringFormat={}{0}%}" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Generate Button -->
                <Button x:Name="btnGenerate" Grid.Column="1" Grid.Row="1" Content="Generate Preview" Width="120"
                        Height="30" Margin="0,5,0,0" Click="BtnGenerate_Click"/>
            </Grid>
        </GroupBox>

        <!-- Preview Area -->
        <GroupBox Header="Preview" Margin="0,0,0,10" Padding="5" Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#F0F0F0" Margin="0,0,0,10">
                <Image x:Name="imgPreview" Width="Auto" Height="Auto" Stretch="None" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="previewScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer>
        </GroupBox>

        <!-- Save Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button x:Name="btnSave" Content="SAVE" Width="100" Height="35"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click" IsEnabled="False"/>
            <TextBlock Text=" generates PNG and FONT files" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
        </StackPanel>

    </Grid>
</Window>
